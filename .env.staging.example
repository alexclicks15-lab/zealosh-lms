# ==============================================================================
# Zealosh LMS — Staging Environment Configuration Template (.env.staging)
# Dedicated Staging Node: https://lms.staging.zealosh.com
# Staging Learning Engine: https://lms.staging.zealosh.com/learn-engine
# ==============================================================================

# 1. Application & Domain Configuration
NODE_ENV=production
PORT=3000
ZEALOSH_ENVIRONMENT=staging
ZEALOSH_DOMAIN=lms.staging.zealosh.com
APP_BASE_URL=https://lms.staging.zealosh.com
NEXT_PUBLIC_APP_URL=https://lms.staging.zealosh.com
NGINX_CONF_FILE=nginx.staging.conf

# Authoritative Store Persistence
DATABASE_STORAGE=supabase
DATA_STORE_PATH=/app/data/zealosh-store.json

# Cryptographic Authentication & JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_STAGING_SECURE_JWT_SECRET_2026
JWT_EXPIRES_IN=7d

# Dedicated OAuth 2 Client Secret for registered Moodle OIDC client (auth_oauth2).
# SECURITY INVARIANT: Must remain strictly independent and decoupled from JWT_SECRET.
# ACTIVATION POLICY:
# - In staging/production, generate a strong random secret (e.g. openssl rand -base64 32).
#   When set to a non-empty string, /api/oauth/token strictly requires and validates client_secret.
# - If unset or empty (local development), PKCE verification alone is enforced.
# - Never configure a placeholder value in a live deployed environment.
OAUTH_CLIENT_SECRET=CHANGE_ME_STAGING_OAUTH_CLIENT_SECRET_2026

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT 1: Zealosh Core Hub (Application Data, Courses, Exams)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://yeegsljnjwxdhgzfdnyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_STAGING_SUPABASE_PROJECT_1_KEY

# ------------------------------------------------------------------------------
# 3. SUPABASE PROJECT 2: Zealosh Learning Engine (Dedicated Moodle 5.3 PostgreSQL 17)
# ------------------------------------------------------------------------------
# OPTION A (RECOMMENDED for IPv4 cloud hosts): Supavisor Session Pooler (Port 5432)
# Hostname format: aws-0-[region].pooler.supabase.com
# Username format: postgres.[moodle-staging-project-ref]
MOODLE_DATABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
MOODLE_DATABASE_PORT=5432
MOODLE_DATABASE_NAME=postgres
MOODLE_DATABASE_USER=postgres.your-moodle-staging-project-ref
MOODLE_DATABASE_PREFIX=mdl_

# NOTE: Enclose passwords in single quotes ('...') to prevent Docker Compose variable expansion ($) or comment truncation (#)
MOODLE_DATABASE_PASSWORD='CHANGE_ME_SECURE_MOODLE_STAGING_PASSWORD'
MOODLE_DATABASE_SSLMODE=require
# MOODLE_DATABASE_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt

# Staging Canonical URL & Administrator Credentials
MOODLE_WWWROOT=https://lms.staging.zealosh.com/learn-engine
MOODLE_ADMIN_USER=admin
# NOTE: Moodle administrator password is now provisioned securely via Docker Compose secret
# from ./secrets/moodle_admin_password.txt (mode 0600) rather than a Compose environment variable.
# Do not store raw administrator passwords in .env.staging.
MOODLE_ADMIN_EMAIL=admin@staging.zealosh.com
MOODLE_SITE_FULLNAME='Zealosh Learning Engine (Staging)'
MOODLE_SITE_SHORTNAME='Zealosh LMS Staging'

# ------------------------------------------------------------------------------
# 4. Redis Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_HOST=zealosh-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_2026

# ------------------------------------------------------------------------------
# 5. Live Classroom Media Cluster (BigBlueButton Server 2)
# ------------------------------------------------------------------------------
BBB_BASE_URL=https://media.staging.zealosh.com/bigbluebutton/api
BBB_SECURITY_SALT=CHANGE_ME_BBB_STAGING_SHARED_SALT_2026
# Compatibility aliases
BBB_MEDIA_URL=https://media.staging.zealosh.com/bigbluebutton/api
BBB_SHARED_SECRET=CHANGE_ME_BBB_STAGING_SHARED_SALT_2026
