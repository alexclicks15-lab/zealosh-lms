# Zealosh LMS — Production Environment Configuration Template
# Copy to .env.production on target host. NEVER commit secrets to source control.

# Application Configuration
NODE_ENV=production
PORT=3000
ZEALOSH_ENVIRONMENT=production
ZEALOSH_DOMAIN=lms.zealosh.com
APP_BASE_URL=https://lms.zealosh.com
NEXT_PUBLIC_APP_URL=https://lms.zealosh.com
NGINX_CONF_FILE=nginx.production.conf

# Authoritative Store Persistence
DATABASE_STORAGE=supabase
DATA_STORE_PATH=/app/data/zealosh-store.json

# Cryptographic Authentication & JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_SUPER_SECURE_JWT_SECRET_2026_PRODUCTION
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 1. SUPABASE PROJECT 1: Zealosh Core Hub (Application Data, Courses, Exams, Users)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://yeegsljnjwxdhgzfdnyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_PROJECT_1_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT 2: Zealosh Learning Engine (Dedicated Moodle 5.3 PostgreSQL 17)
# Select ONE connection mode below based on staging host networking:
# ------------------------------------------------------------------------------
# OPTION A (RECOMMENDED for standard IPv4 cloud hosts): Supavisor Session Pooler
# Hostname format: aws-0-[region].pooler.supabase.com (Port 5432 Session Mode)
# Username format: postgres.[your-moodle-project-ref] (tenant suffix required)
MOODLE_DATABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
MOODLE_DATABASE_PORT=5432
MOODLE_DATABASE_NAME=postgres
MOODLE_DATABASE_USER=postgres.your-moodle-project-ref
# NOTE: Enclose passwords in single quotes ('...') to prevent Docker Compose variable expansion ($) or comment truncation (#)
MOODLE_DATABASE_PASSWORD='CHANGE_ME_SECURE_MOODLE_SUPABASE_PASSWORD'
# SSL Configuration:
# - 'require' (default): Encrypts connection; does not verify server CA certificate.
# - 'verify-full': Encrypts connection AND verifies certificate identity against CA bundle.
#   (Compatible with Supavisor pooler using system CA bundle: /etc/ssl/certs/ca-certificates.crt)
MOODLE_DATABASE_SSLMODE=require
# MOODLE_DATABASE_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt

# OPTION B (For dual-stack IPv6 hosts OR Supabase IPv4 Add-on subscribers):
# Direct Connection: db.[your-moodle-project-ref].supabase.co (Port 5432)
# Username: postgres (no suffix)
# MOODLE_DATABASE_HOST=db.your-moodle-project-ref.supabase.co
# MOODLE_DATABASE_PORT=5432
# MOODLE_DATABASE_USER=postgres
# MOODLE_DATABASE_SSLMODE=require
# (For direct mode with verify-full, download Supabase prod-ca-2021.crt and mount to container)
# MOODLE_DATABASE_SSLROOTCERT=/etc/ssl/certs/supabase-prod-ca.crt

MOODLE_WWWROOT=https://lms.zealosh.com/learn-engine
# NOTE: Moodle administrator password is now provisioned securely via Docker Compose secret
# from ./secrets/moodle_admin_password.txt (mode 0600) rather than a Compose environment variable.
# Do not store raw administrator passwords in .env.production.


# ------------------------------------------------------------------------------
# 3. Redis Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_2026

# ------------------------------------------------------------------------------
# 4. BigBlueButton Live Classroom Media Secret (From Server 2 bbb-conf --secret)
# ------------------------------------------------------------------------------
BBB_BASE_URL=https://classroom.zealosh.com/bigbluebutton/api
BBB_SECURITY_SALT=CHANGE_ME_BBB_SALT_FROM_BBB_CONF
