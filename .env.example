# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Zealosh Training & Consultants"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication
JWT_SECRET="zealosh-development-secret-jwt-key-2026-secure"
JWT_EXPIRES_IN="7d"

# Integration Adapters
MOODLE_MODE="mock" # 'mock' or 'remote'
MOODLE_BASE_URL="https://moodle.internal.zealosh.com"
MOODLE_WS_TOKEN="mock_moodle_token"

BIGBLUEBUTTON_MODE="mock" # 'mock' or 'remote'
BIGBLUEBUTTON_BASE_URL="https://bbb.internal.zealosh.com/bigbluebutton/api"
BIGBLUEBUTTON_SALT="mock_bbb_secret_salt_12345"

# Database Storage Mode
DATABASE_STORAGE="in_memory" # 'in_memory' or 'postgres'
