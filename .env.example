# ==============================================================================
# Zealosh LMS — Complete Environment Configuration Template
# Brand: Zealosh Training & Consultants (Kollam, Kerala, India)
# Classification: Environment Specification & Secrets Inventory
# NOTE: Zero production secrets. Use real credentials only in .env.local or staging-secrets.env.
# ==============================================================================

# 1. CORE APPLICATION RUNTIME
NODE_ENV=development                            # 'development' | 'test' | 'staging' | 'production'
PORT=3000                                       # Server listening port (1-65535)
ZEALOSH_ENVIRONMENT=development                 # 'development' | 'staging' | 'production'
ZEALOSH_DOMAIN=zealosh.com                      # Canonical institutional domain
APP_BASE_URL="http://localhost:3000"            # Base server URL (must be https:// in staging/prod)
NEXT_PUBLIC_APP_NAME="Zealosh Training & Consultants"
NEXT_PUBLIC_APP_URL="http://localhost:3000"     # Public-facing application URL

# 2. AUTHENTICATION & SECURITY
JWT_SECRET="zealosh-development-secret-jwt-key-2026-secure-32chars" # Min 32 chars in staging/prod
JWT_EXPIRES_IN="7d"                             # Token lifetime (e.g., '1d', '7d')
OAUTH_CLIENT_SECRET="optional-oauth-client-secret-if-using-sso"

# 3. DATABASE STORAGE & SUPABASE POSTGRESQL (AUTHORITATIVE)
DATABASE_STORAGE="inmemory"                     # 'inmemory' (dev only) | 'supabase' | 'postgres'
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_anon_key_placeholder"
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_key_placeholder"

# 4. OBJECT STORAGE & S3/CLOUDFLARE R2
S3_BUCKET_NAME="zealosh-staging-uploads"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="r2_access_key_placeholder"
S3_SECRET_ACCESS_KEY="r2_secret_key_placeholder"
STORAGE_BUCKET="zealosh-staging-uploads"

# 5. LIVE VIRTUAL CLASSROOM & BIGBLUEBUTTON 2.7+ (SERVER 2)
BIGBLUEBUTTON_MODE="mock"                       # 'mock' (dev) | 'remote'
BIGBLUEBUTTON_BASE_URL="https://vc.staging.zealosh.com/bigbluebutton/api"
BIGBLUEBUTTON_SALT="mock_bbb_secret_salt_12345"

# 6. MOODLE 4.x REST WEB SERVICES INTEGRATION
MOODLE_MODE="mock"                              # 'mock' (dev) | 'remote'
MOODLE_BASE_URL="https://moodle.internal.zealosh.com"
MOODLE_WS_TOKEN="mock_moodle_token"
MOODLE_DATABASE_HOST="127.0.0.1"
MOODLE_DATABASE_PORT="5432"                     # Strict: 5432 (Session pooler), never 6543
MOODLE_DATABASE_NAME="moodle"
MOODLE_DATABASE_USER="moodleuser"
MOODLE_DATABASE_PASSWORD="moodle_password_placeholder"

# 7. AI INFERENCE & FORMATIVE EVALUATION
GEMINI_API_KEY=""                               # Google Gemini API key (optional managed AI)
OLLAMA_BASE_URL="http://127.0.0.1:11434"        # Self-hosted Ollama endpoint (optional local AI)
OLLAMA_MODEL="llama3.2:3b"

# 8. TRANSACTIONAL EMAIL & SMTP (OUTBOX DISPATCH)
SMTP_HOST="smtp.sendgrid.net"                   # SMTP relay host
SMTP_PORT=587                                   # 587 (STARTTLS) or 465 (SSL)
SMTP_USER="apikey"
SMTP_PASSWORD="smtp_password_placeholder"
EMAIL_FROM="admissions@zealosh.com"

# 9. PAYMENT GATEWAY INTEGRATIONS (RAZORPAY & STRIPE)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# 10. WHATSAPP BUSINESS CLOUD API (CANDIDATE ALERTS)
WHATSAPP_API_KEY="whatsapp_token_placeholder"
WHATSAPP_PHONE_NUMBER_ID="100609345263"

# 11. BACKGROUND WORKER & TRANSACTIONAL DISPATCH
ZEALOSH_WORKER_SUPERVISOR="systemd"             # 'systemd' (authoritative production) | 'pm2' | 'standalone'
WORKER_INTERVAL_MS=30000                        # Dispatch cycle interval (30 seconds)

# 12. OPERATIONAL TELEMETRY & DIAGNOSTICS
LOG_LEVEL="info"                                # 'debug' | 'info' | 'warn' | 'error'
DIAGNOSTICS_ENABLED="true"                      # Internal admin diagnostics telemetry switch
