# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Zealosh Training & Consultants"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication
JWT_SECRET="zealosh-development-secret-jwt-key-2026-secure"
JWT_EXPIRES_IN="7d"

# Integration Adapters
MOODLE_MODE="mock" # 'mock' or 'remote'
MOODLE_BASE_URL="https://moodle.internal.zealosh.com"
MOODLE_WS_TOKEN="mock_moodle_token"

BIGBLUEBUTTON_MODE="mock" # 'mock' or 'remote'
BIGBLUEBUTTON_BASE_URL="https://bbb.internal.zealosh.com/bigbluebutton/api"
BIGBLUEBUTTON_SALT="mock_bbb_secret_salt_12345"

# Database Storage Mode
DATABASE_STORAGE="in_memory" # 'in_memory' or 'postgres' or 'supabase'

# Supabase Database & Auth (Optional Cloud Provider)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
