# ==============================================================================
# Zealosh LMS — Outbox Dispatcher Systemd Timer Unit
# Path: /etc/systemd/system/zealosh-worker.timer
# Periodically triggers zealosh-worker.service every 30 seconds
# ==============================================================================

[Unit]
Description=Trigger Zealosh Outbox Worker Every 30 Seconds
After=network.target

[Timer]
OnBootSec=15s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target

